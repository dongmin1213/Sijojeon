[remap]

importer="csv_translation"
type="Translation"
uid="uid://csv_translations"

[deps]

source_file="res://translations/translations.csv"
dest_files=["res://.godot/imported/translations.csv-hash.ko.translation", "res://.godot/imported/translations.csv-hash.en.translation"]

[params]

compress=true
delimiter=0
