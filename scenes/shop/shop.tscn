[gd_scene load_steps=6 format=3 uid="uid://shop_scene"]

[ext_resource type="Script"    path="res://scenes/shop/shop.gd"               id="1"]
[ext_resource type="Theme"     path="res://resources/joseon_theme.tres"        id="2"]
[ext_resource type="Texture2D" path="res://art/backgrounds/shop_bg.svg"        id="3"]

; 헤더 바 — 고정, 반투명 어둡게
[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_header"]
bg_color = Color(0.03, 0.02, 0.06, 0.88)
border_width_bottom = 1
border_color = Color(0.83, 0.66, 0.26, 0.3)
content_margin_left = 20.0
content_margin_right = 20.0
content_margin_top = 12.0
content_margin_bottom = 12.0

; 푸터 바 — 고정, 반투명
[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_footer"]
bg_color = Color(0.03, 0.02, 0.06, 0.85)
border_width_top = 1
border_color = Color(0.83, 0.66, 0.26, 0.25)
content_margin_left = 20.0
content_margin_right = 20.0
content_margin_top = 10.0
content_margin_bottom = 10.0

[node name="Shop" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2")
script = ExtResource("1")

[node name="Background" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
texture = ExtResource("3")
expand_mode = 1
stretch_mode = 6

; ─── 고정 헤더 (0-8%) — 상점 제목 + 소지금 ────────────────────────────────
[node name="Header" type="PanelContainer" parent="."]
theme_override_styles/panel = SubResource("StyleBoxFlat_header")
layout_mode = 1
anchors_preset = -1
anchor_left = 0.0
anchor_top = 0.0
anchor_right = 1.0
anchor_bottom = 0.08
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 1

[node name="HBoxContainer" type="HBoxContainer" parent="Header"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 24

[node name="TitleLabel" type="Label" parent="Header/HBoxContainer"]
layout_mode = 2
text = "SHOP_TITLE"
theme_override_font_sizes/font_size = 36
theme_override_colors/font_color = Color(0.83, 0.66, 0.26, 1.0)

[node name="GoldLabel" type="Label" parent="Header/HBoxContainer"]
layout_mode = 2
text = ""
theme_override_font_sizes/font_size = 28
theme_override_colors/font_color = Color(0.83, 0.66, 0.26, 0.9)

; ─── 스크롤 콘텐츠 (8-90%) ────────────────────────────────────────────────
[node name="ScrollArea" type="ScrollContainer" parent="."]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.0
anchor_top = 0.08
anchor_right = 1.0
anchor_bottom = 0.90
grow_horizontal = 2
grow_vertical = 2
horizontal_scroll_mode = 0

[node name="VBoxContainer" type="VBoxContainer" parent="ScrollArea"]
layout_mode = 2
