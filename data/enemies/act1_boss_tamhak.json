          { "type": "apply_buff", "buff": "strength", "stacks": 2, "target": "self" },
          { "type": "dialogue", "text": "감히 버티겠다는 것이냐! 세금을 두 배로 내라!" }
        ]
      }
    },
    {
      "phase": 2,
      "hp_threshold_label": "60% → 25%",
      "hp_threshold_min": 30,
      "description": "분노 모드. 착취 금액이 두 배로 늘고 공격이 거세진다.",
      "start_of_turn_passive_override": {
        "intent": "gold_drain",
        "name": "이중 착취세",
        "drain_amount": 30,
        "hp_fallback": 15,
        "description": "페이즈 2: 엽전 30 강탈. 없으면 HP 15 손실."
      },
      "moves": [
        {
          "id": "rage_strike",
          "name": "분노 강타",
          "intent": "attack",
          "damage": 13,
          "times": 1,
          "description": "13피해."
        },
        {
          "id": "official_tyranny",
          "name": "관권 횡포",
          "intent": "attack_debuff",
          "damage": 8,
          "times": 1,
          "effects": [
            { "type": "apply_debuff", "debuff": "취약", "stacks": 2, "target": "player" }
          ],
          "description": "8피해 + 취약 2."
        },
        {
          "id": "iron_decree",
          "name": "철권 령",
          "intent": "attack",
          "damage": 10,
          "times": 2,
          "description": "10피해 × 2."
        }
      ],
      "move_pattern": {
        "type": "sequential",
        "sequence": [
          "rage_strike",
          "official_tyranny",
          "iron_decree",
          "rage_strike",
          "official_tyranny"
        ]
      },
      "phase_trigger": {
        "type": "hp_threshold",
        "hp_percent": 25,
        "on_trigger": [
          {
            "type": "apply_debuff",
            "debuff": "death_countdown",
            "stacks": 3,
            "target": "player"
          },
          { "type": "dialogue", "text": "이 고을은 내 것이다! 죽어도 내 것이다!" }
        ]
      }
    },
    {
      "phase": 3,
      "hp_threshold_label": "25% → 0%",
      "description": "필사 모드. 패배를 직감하고 폭주한다.",
      "moves": [
        {
          "id": "death_blow",
          "name": "최후의 일격",
          "intent": "attack",
          "damage": 18,
          "times": 1,
          "description": "18피해."
        },
        {
          "id": "desperate_block",
          "name": "필사 방어",
          "intent": "defend_buff",
          "block": 8,
          "effects": [
            { "type": "apply_buff", "buff": "strength", "stacks": 1, "target": "self" }
          ],
          "description": "방어도 8 + 힘 1."
        }
      ],
      "move_pattern": {
        "type": "sequential",
        "sequence": ["death_blow", "desperate_block", "death_blow"]
      }
    }
  ],

  "rewards": {
    "gold_base": 80,
    "gold_bonus_from_drained": true,
    "gold_bonus_note": "강탈당한 엽전의 50% 환급."
  },

  "minshim_on_defeat": 15,

  "balance_note": "HP 120. 패시브 골드 강탈 15/턴. 전투 길이 목표: 10~13턴. 페이즈 2 힘+2, 페이즈 3 카운트다운 3턴."
}
