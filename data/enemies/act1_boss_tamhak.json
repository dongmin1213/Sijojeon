      "moves": [
        {
          "id": "extort_strike",
          "name": "착취 일격",
          "intent": "attack",
          "damage": 9,
          "times": 1,
          "description": "9피해."
        },
        {
          "id": "decree_wall",
          "name": "관인 방벽",
          "intent": "defend",
          "block": 12,
          "description": "방어도 12 획득."
        },
        {
          "id": "menace",
          "name": "위협",
          "intent": "debuff",
          "effects": [
            { "type": "apply_debuff", "debuff": "약화", "stacks": 1, "target": "player" }
          ],
          "description": "약화 1 부여."
        },
        {
          "id": "double_extort",
          "name": "이중 착취",
          "intent": "attack",
          "damage": 7,
          "times": 2,
          "description": "7피해 × 2."
        }
      ],
      "move_pattern": {
        "type": "sequential",
        "sequence": [
          "extort_strike",
          "decree_wall",
          "menace",
          "extort_strike",
          "double_extort",
          "decree_wall"
