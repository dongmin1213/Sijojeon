  "start_of_turn_passive": {
    "intent": "gold_drain",
    "name": "세금 강탈",
    "drain_amount": 15,
    "hp_fallback": 10,
    "description": "매 적 턴 시작 시: 플레이어 엽전 15 강탈. 엽전이 없으면 HP 10 손실."
  },

  "phases": [
    {
      "phase": 1,
      "hp_threshold_label": "100% → 60%",
      "hp_threshold_min": 72,
