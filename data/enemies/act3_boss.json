{
  "version": "0.2",
  "type": "boss",
  "act": 3,
  "balance_ref": "ZER-330. 플레이어 기준: HP 20~40, 덱 18~24장, 턴당 피해 18~24, 방어도 12~16. 보스 목표 전투 길이: 15~18턴. 시조 완성 3회 필수.",
  "id": "B_ACT3_FINAL",
  "name": {
    "ko": "역모대감",
    "romanized": "Yeokmo Daegam",
    "en": "The Treasonous Lord"
  },
  "description": {
    "ko": "왕위를 노리는 역모의 주모자. 충신의 가면을 쓰고 조정을 농단해 왔다. 가면을 쓴 동안 진정한 피해를 줄 수 없다. 시조를 세 번 완성하여 가면을 벗겨야 한다.",
    "en": "The mastermind of treason who covets the throne. Has manipulated the court while wearing the mask of loyalty. Cannot be truly harmed while masked. Complete three sijo to shatter the mask."
  },
  "hp": 195,
  "flavor": "\"충신이 무엇인지 보여주마. 이 나라의 진정한 주인은 나니라.\"",
  "puzzle_mechanic": {
    "type": "loyalty_mask",
    "name": {
      "ko": "충신 가면",
      "en": "Mask of Loyalty"
    },
    "description": {
      "ko": "가면 내구도 3. 가면이 있는 동안 받는 피해 40% 감소 + 디버프 면역. 시조 완성 1회당 가면 1 균열. 가면 파괴 시 역모대감 약화 3 + 취약 3 + 힘 절반 감소.",
      "en": "Mask durability 3. While masked: 40% damage reduction + debuff immunity. Each sijo completion cracks mask by 1. When shattered: 3 Weak + 3 Vulnerable + halve Strength."
    },
    "mask_durability": 3,
    "damage_reduction_percent": 40,
    "debuff_immunity": true,
    "on_sijo_complete": {
      "crack_mask": 1,
      "dialogue_per_crack": [
        {
          "ko": "\"흠... 대단한 문재로구나. 하나 그것으로는 부족하다.\"",
          "en": "\"Hmm... impressive literary talent. But it is not enough.\""
        },
        {
          "ko": "\"뭐... 뭐냐! 가면에 금이...! 이럴 수가!\"",
          "en": "\"Wh-what?! A crack in the mask...! Impossible!\""
        },
        {
          "ko": "\"안 돼! 가면이... 깨진다!\"",
          "en": "\"No! The mask... is breaking!\""
        }
      ]
    },
    "on_mask_shattered": {
      "apply_to_boss": [
        {
          "type": "apply_debuff",
          "debuff": "약화",
          "stacks": 3
        },
        {
          "type": "apply_debuff",
          "debuff": "취약",
          "stacks": 3
        }
      ],
      "halve_strength": true,
      "dialogue": {
        "ko": "\"크아아아! 이 가면 없이는... 나는... 나는 아무것도 아니란 말이냐!\"",
        "en": "\"AAAARGH! Without this mask... am I... am I nothing?!\""
      }
    }
  },
  "phases": [
    {
      "phase": 1,
      "phase_label": "충신의 탈",
      "hp_threshold_label": "100% → 60%",
      "hp_threshold_min": 117,
      "description": "가면을 쓴 채 충신 행세. 부하를 소환하고 방어에 집중하며, 교묘한 디버프로 플레이어를 압박.",
      "moves": [
        {
          "id": "call_to_arms",
          "name": {
            "ko": "거병령",
            "en": "Call to Arms"
          },
