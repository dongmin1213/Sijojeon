          "name": "문서 지옥",
          "intent": "debuff",
          "effects": [
            { "type": "apply_debuff", "debuff": "냉기", "stacks": 1, "target": "player" },
            { "type": "apply_debuff", "debuff": "약화", "stacks": 1, "target": "player" }
          ],
          "description": "관료주의의 속박. 냉기 1(다음 턴 드로우 -1) + 약화 1 부여."
        }
