          {
            "type": "apply_debuff",
            "debuff": "death_countdown",
            "stacks": 4,
            "target": "player",
            "note": "사망 카운트다운: 4턴 후 플레이어 현재 HP 40% 강제 감소. 판서 처치 시 즉시 해제."
          },
          { "type": "dialogue", "text": "왕명이니라! 이 자를 당장 처형하라!" }
        ]
      },
      "moves": [
        {
          "id": "royal_decree_strike",
          "name": "왕명 집행",
          "intent": "attack",
          "damage": 8,
          "times": 3,
          "effects": [
            { "type": "strip_buff", "count": 1, "target": "player", "note": "플레이어 버프 1개를 무작위로 제거" }
          ],
          "description": "8피해 × 3회 = 24 총피해 + 플레이어 버프 1개 박탈."
        },
        {
          "id": "seal_of_wrath",
          "name": "진노의 인장",
          "intent": "attack",
          "damage": 22,
          "times": 1,
          "description": "분노가 극에 달한 단발 최대 피해 공격."
        },
        {
          "id": "final_authority",
          "name": "최후의 권위",
          "intent": "defend_buff",
          "block": 10,
          "effects": [
            { "type": "apply_buff", "buff": "strength", "stacks": 1, "target": "self" }
          ],
          "description": "방어도 10 + 힘 1. 극단적 상황에서의 마지막 방어 시도."
        }
      ],
      "move_pattern": {
        "type": "sequential",
        "sequence": [
          "royal_decree_strike",
          "seal_of_wrath",
