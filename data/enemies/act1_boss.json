          { "type": "dialogue", "text": "감히 판서를 건드려! 목이 열 개라도 모자라겠구나!" }
        ]
      },
      "moves": [
        {
          "id": "golden_seal_slam",
          "name": "금인 강타",
          "intent": "attack",
          "damage": 14,
          "times": 1,
          "description": "금인을 들어 내리찍는 강력한 일격. 힘 보너스 적용."
