      "move_pattern": {
        "type": "sequential",
        "sequence": [
          "golden_seal_slam",
          "abuse_of_power",
          "double_seal",
          "golden_seal_slam",
          "enraged_fortify",
          "double_seal",
          "abuse_of_power"
        ]
      }
    },
    {
      "phase": 3,
      "hp_threshold_label": "30% → 0%",
      "description": "최후 모드. 패배를 직감한 판서가 왕명을 빙자한 극단적 수단을 동원. 사망 카운트다운을 발동하여 즉결 처형을 위협한다.",
      "phase_trigger": {
        "type": "hp_threshold",
        "hp_percent": 30,
        "on_trigger": [
          { "type": "cleanse_debuffs", "target": "self" },
