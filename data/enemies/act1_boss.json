{
  "version": "0.2",
  "type": "boss",
  "act": 1,
  "balance_ref": "ZER-330. 플레이어 기준: HP 70, 기/턴 3, 스타터 덱 평균 1턴 피해 6~8, 방어도 5. 보스 목표 전투 길이: 12~15턴.",
  "id": "B_ACT1_FINAL",
  "name": {
    "ko": "변학도",
    "romanized": "Byeon Hak-do",
    "en": "Magistrate Byeon"
  },
  "description": {
    "ko": "남원부사 변학도. 춘향을 옥에 가두고 형벌을 내리는 탐관오리. 형장을 앞세워 복종을 강요하며, 매질의 공포로 백성을 지배한다. 시조를 읊어 간청해야만 형벌을 멈출 수 있다.",
    "en": "Magistrate Byeon of Namwon. A corrupt official who imprisons Chunhyang and orders punishments. Rules through fear of the rod. Only a sijo plea can stay the punishment."
  },
  "hp": 115,
  "flavor": "\"관장의 명이 곧 법이니라! 이 년을 당장 곤장 쳐라!\"",
  "puzzle_mechanic": {
    "type": "punishment_counter",
    "name": {
      "ko": "형벌 카운터",
      "en": "Punishment Counter"
    },
    "description": {
      "ko": "매 턴 형벌 +1 누적. 5에 도달하면 '곤장 집행'으로 전체 HP 30% 피해. 시조 완성 시 형벌 초기화 + 변학도 취약 2턴.",
      "en": "Punishment +1 each turn. At 5, executes Rod Punishment for 30% max HP damage. Sijo completion resets counter + applies Vulnerable 2."
    },
    "max_stacks": 5,
    "on_max": {
      "damage_percent": 30,
      "dialogue": {
        "ko": "\"곤장 서른 대! 아직도 항거하겠느냐!\"",
        "en": "\"Thirty strikes of the rod! Will you still resist?\""
      }
    },
    "on_sijo_complete": {
      "reset_counter": true,
      "apply_to_boss": [
        {
          "type": "apply_debuff",
          "debuff": "취약",
          "stacks": 2
        }
      ],
      "dialogue": {
        "ko": "\"무... 무엇이냐! 감히 시조를 읊어 본관을 거스르다니!\"",
        "en": "\"Wh-what?! How dare you recite a sijo to defy this magistrate!\""
      }
    }
  },
  "phases": [
    {
      "phase": 1,
      "hp_threshold_label": "100% → 60%",
      "hp_threshold_min": 69,
      "description": "위세 모드. 형벌 카운터를 쌓으며 디버프로 압박. 호위 포졸을 소환해 방패삼는다.",
      "moves": [
