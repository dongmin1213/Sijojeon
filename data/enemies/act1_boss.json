            { "type": "apply_debuff", "debuff": "취약", "stacks": 1, "target": "player" }
          ],
          "description": "플레이어에게 약화 1 + 취약 1 부여. 이번 턴 반격 억제."
        },
        {
          "id": "seal_strike",
          "name": "인장 타격",
          "intent": "attack",
          "damage": 10,
          "times": 1,
          "description": "묵직한 관인으로 내리치는 공격."
        },
        {
          "id": "official_shield",
          "name": "관인 방패",
          "intent": "defend",
          "block": 14,
          "description": "관료적 권위로 둘러싼 방어막. 방어도 14 획득."
        },
        {
          "id": "summon_guard",
          "name": "금의위 소환",
          "intent": "summon",
          "summons": "E002",
          "summon_count": 1,
          "description": "포졸 1명을 소환. 처치 시 재소환 없음."
        },
        {
