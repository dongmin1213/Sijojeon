{
  "version": "0.2",
  "type": "boss",
  "act": 2,
  "balance_ref": "ZER-330. 플레이어 기준: HP 30~50(2막 진입 후), 덱 14~18장, 턴당 피해 12~18. 보스 목표 전투 길이: 14~18턴.",
  "id": "B_ACT2_FINAL",
  "name": {
    "ko": "이무기",
    "romanized": "Imugi",
    "en": "Imugi"
  },
  "description": {
    "ko": "천 년을 기다려 용이 되려는 거대한 이무기. 비늘로 온몸을 감싼 채 지리산 깊은 곳에 서린다. 비늘을 벗기지 않으면 진정한 피해를 줄 수 없다. 시조의 힘으로 비늘을 벗겨야 한다.",
    "en": "A great serpent that has waited a thousand years to ascend. Wrapped in scales deep in Jirisan. Cannot be truly harmed until its scales are stripped — only the power of sijo can breach them."
  },
  "hp": 160,
  "flavor": "\"천 년을 기다렸다... 용이 되는 것을 막을 자는 없느니라!\"",
  "puzzle_mechanic": {
    "type": "scale_barrier",
    "name": {
      "ko": "비늘 방어막",
      "en": "Scale Barrier"
    },
    "description": {
      "ko": "비늘 3겹 보유. 비늘이 있는 동안 받는 피해 50% 감소. 시조 완성 1회당 비늘 1겹 벗김. 비늘 0이 되면 취약 2턴 + 받는 피해 정상화.",
      "en": "3 layers of scales. While scales remain, takes 50% reduced damage. Each sijo completion strips 1 layer. At 0 scales, becomes Vulnerable for 2 turns."
    },
    "max_scales": 3,
    "damage_reduction_percent": 50,
    "on_sijo_complete": {
      "strip_scales": 1,
      "dialogue_per_scale": [
        {
          "ko": "\"크르르... 비늘이... 감히!\"",
          "en": "\"Grr... my scales... how dare you!\""
        },
        {
          "ko": "\"으아아! 살갗이 드러나다니!\"",
          "en": "\"Aaargh! My flesh is exposed!\""
        },
        {
          "ko": "\"안 돼! 서기가... 빛을 잃는다!\"",
          "en": "\"No! My aura... is losing its light!\""
        }
      ]
    },
    "on_all_stripped": {
      "apply_to_boss": [
        {
          "type": "apply_debuff",
          "debuff": "취약",
          "stacks": 2
        }
      ],
      "dialogue": {
        "ko": "\"으아아아! 비늘이 모두... 천 년의 수련이...!\"",
        "en": "\"AAAARGH! All my scales... a thousand years of cultivation...!\""
      }
    },
    "scale_regen": {
      "enabled": true,
      "turns_to_regen": 4,
      "regen_amount": 1,
      "dialogue": {
        "ko": "\"비늘이 다시 자라난다... 승천을 막을 수 없으리라!\"",
        "en": "\"My scales regrow... you cannot stop my ascension!\""
      }
    }
  },
